    "table_g2g_partners": {
        "create": "CREATE TABLE `g2g_partners` (\n  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,\n  `sub_institute_id` bigint(20) unsigned DEFAULT NULL,\n  `partner_id` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `partner_name` varchar(191) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `partner_type` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `hq_state` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `states_covered` longtext COLLATE utf8mb4_unicode_ci,\n  `segments_covered` longtext COLLATE utf8mb4_unicode_ci,\n  `needs_addressed` longtext COLLATE utf8mb4_unicode_ci,\n  `procurement_routes` longtext COLLATE utf8mb4_unicode_ci,\n  `offers_authorized` longtext COLLATE utf8mb4_unicode_ci,\n  `empanelments` longtext COLLATE utf8mb4_unicode_ci,\n  `certifications` longtext COLLATE utf8mb4_unicode_ci,\n  `key_buyer_relationships` text COLLATE utf8mb4_unicode_ci,\n  `delivery_capability` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `max_concurrent_deals` smallint(5) unsigned NOT NULL DEFAULT '1',\n  `active_deals_now` smallint(5) unsigned NOT NULL DEFAULT '0',\n  `capacity_available` int(11) NOT NULL DEFAULT '1',\n  `sales_contact_name` varchar(191) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `contact_email` varchar(191) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `contact_phone` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `preferred_channel` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `commercial_model` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `referral_margin_pct` decimal(5,2) DEFAULT NULL,\n  `deal_registration_agreed` tinyint(1) NOT NULL DEFAULT '0',\n  `conflicts` text COLLATE utf8mb4_unicode_ci,\n  `leads_received` int(10) unsigned NOT NULL DEFAULT '0',\n  `acknowledged_within_sla` int(10) unsigned NOT NULL DEFAULT '0',\n  `deals_won` int(10) unsigned NOT NULL DEFAULT '0',\n  `partner_status` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'Prospect',\n  `conversion_rate` decimal(5,4) DEFAULT NULL,\n  `avg_days_to_first_meeting` smallint(5) unsigned DEFAULT NULL,\n  `notes` text COLLATE utf8mb4_unicode_ci,\n  `is_example` tinyint(1) NOT NULL DEFAULT '0',\n  `created_by` bigint(20) unsigned DEFAULT NULL,\n  `updated_by` bigint(20) unsigned DEFAULT NULL,\n  `created_at` timestamp NULL DEFAULT NULL,\n  `updated_at` timestamp NULL DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  KEY `g2g_partners_tenant_partner_id` (`sub_institute_id`,`partner_id`),\n  KEY `g2g_partners_tenant_status` (`sub_institute_id`,`partner_status`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
        "rows": 0
    },
