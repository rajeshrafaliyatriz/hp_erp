APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

# WHERE THE NEXT.JS APP LIVES. THIS IS NOT THIS SERVER.
#
# Laravel serves the API; a separate Next.js app serves the pages people open.
# Every link this backend puts in an email is built from here:
#
#   /set-password/{token}   an invited employee setting their first password
#   /assessment/{token}     a candidate taking an assessment
#   /offer/{token}          a candidate accepting an offer
#
# Laravel has NO ROUTE for any of them, so a link built from APP_URL instead
# reaches this API and 404s.
#
# ── GET THIS WRONG AND INVITES SILENTLY DO NOT WORK ─────────────────────────
#
# Left at a localhost value in production, every invite link points at the
# RECIPIENT'S OWN MACHINE, where nothing is running. The token is valid, the
# email sends, and the link is dead on arrival — which is exactly how this was
# found. InviteService now detects a localhost host and returns a warning the
# People & access screen displays, rather than failing quietly.
#
# The real values for this installation:
#
#   production   FRONTEND_URL=https://g2g.scholarclone.com
#   local        FRONTEND_URL=http://localhost:3000
#
# Blank falls back to APP_URL, and the emails that would carry a dead link say
# so instead of reporting success.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=

#---------------------------------------------------------------------
# DeepSeek — task execution classification and ESO generation
#---------------------------------------------------------------------
# Without a key these features refuse cleanly (503) rather than failing;
# they never guess. See config/deepseek.php for what each key does.
DEEPSEEK_API_KEY=

# DEEPSEEK_MODEL IS AN ALIAS, AND WHICH ONE YOU SET MATTERS.
# Measured on this account 2026-08-27 and recorded in config/deepseek.php:
#   deepseek-chat       answers a classification in 252 tokens, valid JSON
#   deepseek-v4-flash   consumes the ENTIRE output allowance, returns nothing usable
#   deepseek-v4-pro     same, at 24x the cost
# A server set to a v4 model does not fail loudly — every generation comes back
# truncated, which reads on screen as "the draft did not fit". Leave this alone
# unless you have re-run that comparison.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Refuse to call DeepSeek below this balance, in USD.
#
# LEAVING IT BLANK IS NOT THE SAME AS LEAVING IT OUT. Absent, env() falls back
# to 1.00 and the guard works. Present but EMPTY casts to 0.0, and the guard
# disables itself silently — the one configuration that spends without a floor.
DEEPSEEK_MIN_BALANCE_USD=1.00

# Seconds to wait for a completion. Generation measured at ~13s; the ceiling is
# for a slow upstream, not for normal work.
DEEPSEEK_REQUEST_TIMEOUT=120
