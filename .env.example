APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

# WHERE THE NEXT.JS APP LIVES. THIS IS NOT THIS SERVER.
#
# Laravel serves the API; a separate Next.js app serves the pages people open.
# Every link this backend puts in an email is built from here:
#
#   /set-password/{token}   an invited employee setting their first password
#   /assessment/{token}     a candidate taking an assessment
#   /offer/{token}          a candidate accepting an offer
#
# Laravel has NO ROUTE for any of them, so a link built from APP_URL instead
# reaches this API and 404s.
#
# ── GET THIS WRONG AND INVITES SILENTLY DO NOT WORK ─────────────────────────
#
# Left at a localhost value in production, every invite link points at the
# RECIPIENT'S OWN MACHINE, where nothing is running. The token is valid, the
# email sends, and the link is dead on arrival — which is exactly how this was
# found. InviteService now detects a localhost host and returns a warning the
# People & access screen displays, rather than failing quietly.
#
# The real values for this installation:
#
#   production   FRONTEND_URL=https://g2g.scholarclone.com
#   local        FRONTEND_URL=http://localhost:3000
#
# Blank falls back to APP_URL, and the emails that would carry a dead link say
# so instead of reporting success.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=

#---------------------------------------------------------------------
# DeepSeek — task execution classification and ESO generation
#---------------------------------------------------------------------
# Without a key these features refuse cleanly (503) rather than failing;
# they never guess. See config/deepseek.php for what each key does.
DEEPSEEK_API_KEY=

# DEEPSEEK_MODEL IS AN ALIAS, AND WHICH ONE YOU SET MATTERS.
# Measured on this account 2026-08-27 and recorded in config/deepseek.php:
#   deepseek-chat       answers a classification in 252 tokens, valid JSON
#   deepseek-v4-flash   consumes the ENTIRE output allowance, returns nothing usable
#   deepseek-v4-pro     same, at 24x the cost
# A server set to a v4 model does not fail loudly — every generation comes back
# truncated, which reads on screen as "the draft did not fit". Leave this alone
# unless you have re-run that comparison.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Refuse to call DeepSeek below this balance, in USD.
#
# LEAVING IT BLANK IS NOT THE SAME AS LEAVING IT OUT. Absent, env() falls back
# to 1.00 and the guard works. Present but EMPTY casts to 0.0, and the guard
# disables itself silently — the one configuration that spends without a floor.
DEEPSEEK_MIN_BALANCE_USD=1.00

# Seconds to wait for a completion. Generation measured at ~13s; the ceiling is
# for a slow upstream, not for normal work.
DEEPSEEK_REQUEST_TIMEOUT=120

#---------------------------------------------------------------------
# Signals: AI credential failover and the market (demand-side) import
#---------------------------------------------------------------------
# More platform Gemini keys, used one by one when a key hits its quota (only when no key is saved
# on the AI Providers screen). Either style, or both:
# GEMINI_API_KEYS=key2,key3
# GEMINI_API_KEY_2=
# Rotation limits (each key is tried at most once per request):
# AI_FAILOVER_PROVIDERS=gemini
# AI_FAILOVER_MAX_ATTEMPTS=20
# AI_FAILOVER_MAX_TRANSIENT_ATTEMPTS=20
# AI_FAILOVER_QUOTA_COOLDOWN=60
# Modules whose saved keys no other module may borrow (default: the Signals module):
# AI_EXCLUSIVE_MODULES=signals
# deepseek-flash / deepseek-v4-* think by default and can return empty JSON; thinking is sent as
# disabled unless this is false:
# DEEPSEEK_DISABLE_THINKING=true

# Market import limits and offer-matching weights (see docs/signals-market-import-schema.md)
# SIGNALS_MARKET_IMPORT_MAX_RECORDS=500
# SIGNALS_MARKET_IMPORT_MAX_KB=5120
# SIGNALS_MATCH_CODE_BOOST=25
# SIGNALS_MATCH_SEGMENT_BONUS=15
# SIGNALS_MATCH_STORE_MIN_SCORE=30

#---------------------------------------------------------------------
# Signals: Data Connectors (YouTube, LinkedIn, Facebook Pages, Instagram)
#---------------------------------------------------------------------
# One-time, per-deployment provider application settings. Ordinary users never set these: they click Connect
# Account in Signals > Ingestion Engine > Data Connectors and sign in with the platform. Full steps, redirect URIs
# and provider approval requirements: docs/signals-connector-admin-setup.md
#
# The three credential pairs below are safe to leave EMPTY: an empty value simply means "not configured", and the
# Data Connectors screen then tells an administrator what is missing (it shows setting names, never values).
# Every OTHER setting in this block is commented out on purpose. Laravel returns an EMPTY string, not the built-in
# default, for a variable that is present but blank, so an uncommented blank would switch scheduling off or blank an
# API version. Uncomment only the ones you want to change, and give them a real value.
#
# Each redirect URI defaults to APP_URL + /api/signals/ingestion/connectors/oauth/<youtube|linkedin|meta>/callback.
# APP_URL must therefore be the PUBLIC address of this API, and the identical URI must be registered at the provider.

# YouTube / Google Cloud OAuth client (Web application). Scope: youtube.readonly
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=https://api.example.com/api/signals/ingestion/connectors/oauth/youtube/callback

# LinkedIn app (needs the approved Community Management API product). Scope: r_organization_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_OAUTH_REDIRECT_URI=https://api.example.com/api/signals/ingestion/connectors/oauth/linkedin/callback
# Linkedin-Version header, format YYYYMM (code default 202610 is not verified against LinkedIn):
# LINKEDIN_API_VERSION=202610

# Meta app, shared by the Facebook Pages and Instagram connectors. Scopes: pages_show_list,
# pages_read_engagement (and instagram_basic for Instagram)
META_APP_ID=
META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://api.example.com/api/signals/ingestion/connectors/oauth/meta/callback
# Graph API version (code default v26.0 is not verified against Meta):
# META_GRAPH_API_VERSION=v26.0

# Where the browser returns after provider sign-in. When this is unset, FRONTEND_URL (the site origin, above) is used
# and /ingestion is appended. Set it only to send users somewhere else; it is used exactly as written.
# SIGNALS_CONNECTORS_FRONTEND_URL=https://app.example.com/ingestion

# Sync behaviour (code defaults shown). Scheduled syncs additionally need the Laravel scheduler and a worker for the
# Signals queue; see "Data connector operations" in docs/product-driven-signals.md.
# SIGNALS_CONNECTOR_MAX_ITEMS=25
# Most provider API pages one sync reads, for every social connector (0 or blank means 10, never unlimited):
# SIGNALS_CONNECTOR_MAX_FETCH_PAGES=10
# Website connector time limits, in seconds. One fetch including its redirects, and robots.txt + page together:
# SIGNALS_INGESTION_URL_TIMEOUT=12
# SIGNALS_INGESTION_URL_OPERATION_TIMEOUT=30
# SIGNALS_CONNECTOR_SCHEDULE_ENABLED=true
# Queue the connector sync jobs use, and the worker command that must be running for it:
#   php artisan queue:work --queue=signals --tries=4 --timeout=900
# SIGNALS_QUEUE=signals
# Must stay above the longest job timeout (900 s) on the ACTIVE queue connection. Validated: QUEUE_CONNECTION=database
# (code default 960). redis/beanstalkd ship with 90, which is unsafe for connector syncs: raise their retry_after above 900.
# Must stay above the longest job timeout (900 s) on the database queue (code default 960):
# DB_QUEUE_RETRY_AFTER=960
